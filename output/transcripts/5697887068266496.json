      "time": "2026-10-15T19:20:22.034055",
      "type": "transcript",
      "user_id": "6576174159265792"
    },
    {
      "content": "ai_scorecard_llm_v2",
      "name": "Amy Arbasa",
      "time": "2026-10-15T19:20:22.034055",
      "type": "moment",
